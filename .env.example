# Copiar a .env (que no se sube al repositorio) y llenar con los valores reales
DB_URL=jdbc:postgresql://localhost:5432/oficioya_worker
DB_USER=
DB_PASSWORD=
# Misma clave que usa Identity para firmar los tokens, en Base64; minimo 32 bytes decodificados
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
PUBLIC_QUERIES=false
